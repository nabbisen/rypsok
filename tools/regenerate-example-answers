#!/usr/bin/env python3
"""Regenerates the page-backed answers of examples/calls (RFC 020, TST-13).

The four answers `calls/web-fetch-ok.json`, `-continuation.json`,
`-continuation-2.json` and `-redirected.json` come from a real `rypsok serve`
over standard input and output, with a loopback server standing in for the
site: `examples/pages/rust-ownership.html` at `/rust-ownership`, and a
redirect from `/moved` to another host. The loopback address in the answers
is replaced by `https://example.org`, as the book shows it.

    tools/regenerate-example-answers [--binary PATH] [--write]

Without `--write` it prints what differs from the committed files and exits 1
when something does. With `--write` it replaces the files. It needs a built
binary (default `target/debug/rypsok`) and Python 3 only.
"""
import argparse
import http.server
import json
import pathlib
import subprocess
import sys
import tempfile
import threading

ROOT = pathlib.Path(__file__).resolve().parent.parent
CALLS = ROOT / "examples" / "calls"
PAGE = ROOT / "examples" / "pages" / "rust-ownership.html"
NAMES = ["web-fetch-ok", "web-fetch-continuation", "web-fetch-continuation-2", "web-fetch-redirected"]
DISCOVER = {
    "jsonrpc": "2.0", "id": 1, "method": "server/discover",
    "params": {"_meta": {
        "io.modelcontextprotocol/protocolVersion": "2026-07-28",
        "io.modelcontextprotocol/clientInfo": {"name": "tutorial", "version": "1"},
        "io.modelcontextprotocol/clientCapabilities": {},
    }},
}


class Site(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/rust-ownership":
            body = PAGE.read_bytes()
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
        elif self.path == "/moved":
            self.send_response(301)
            self.send_header("Location", "https://example.org/new")
            self.send_header("Content-Length", "0")
            self.end_headers()
        else:
            self.send_response(404)
            self.send_header("Content-Length", "0")
            self.end_headers()

    def log_message(self, *args):
        pass


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--binary", default=str(ROOT / "target" / "debug" / "rypsok"))
    parser.add_argument("--write", action="store_true")
    parser.add_argument("--show", action="store_true", help="print the differing parts")
    args = parser.parse_args()

    server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Site)
    port = server.server_address[1]
    threading.Thread(target=server.serve_forever, daemon=True).start()
    origin = f"http://127.0.0.1:{port}"

    requests = {name: json.loads((CALLS / f"{name}.json").read_text())["request"] for name in NAMES}
    for request in requests.values():
        args_ = request["params"]["arguments"]
        args_["url"] = args_["url"].replace("https://example.org", origin)

    config = f"""config_version = 1
[egress]
allow = ["127.0.0.1/32"]
allow_http = true
[fetch]
ports = [80, 443, {port}]
max_chars = 5000
max_chars_ceiling = 20000
follow_cross_host_redirects = false
[engines.wikipedia]
type = "wikipedia"
categories = ["general", "science"]
"""
    with tempfile.TemporaryDirectory() as scratch:
        path = pathlib.Path(scratch) / "rypsok.toml"
        path.write_text(config)
        # The files reuse ids (two of them are 3), so each request goes out
        # with an id of its own and the answer gets its file's id back.
        sent = {}
        for index, (name, request) in enumerate(requests.items()):
            sent[name] = {**request, "id": 100 + index}
        lines = [json.dumps({**DISCOVER, "id": 99})] + [json.dumps(r) for r in sent.values()]
        run = subprocess.run(
            [args.binary, "serve", "--config", str(path)],
            input="\n".join(lines) + "\n", capture_output=True, text=True, timeout=60,
        )
    if run.returncode != 0:
        print(run.stderr, file=sys.stderr)
        return 2
    answers = {}
    for line in run.stdout.splitlines():
        message = json.loads(line)
        answers[message["id"]] = message
    differs = False
    for name, request in requests.items():
        response = {**answers[sent[name]["id"]], "id": request["id"]}
        text = json.dumps(response).replace(origin, "https://example.org")
        response = json.loads(text)
        request = json.loads(json.dumps(request).replace(origin, "https://example.org"))
        committed = json.loads((CALLS / f"{name}.json").read_text())
        fresh = {"request": request, "response": response}
        if "_note" in committed:
            fresh["_note"] = committed["_note"]
        if fresh != committed:
            differs = True
            print(f"{name}: differs from the committed file")
            if args.show:
                for key in ("request", "response"):
                    if fresh.get(key) != committed.get(key):
                        print(f"  {key}:\n  fresh:     {json.dumps(fresh[key])[:900]}\n  committed: {json.dumps(committed[key])[:900]}")
            if args.write:
                (CALLS / f"{name}.json").write_text(json.dumps(fresh, indent=2, ensure_ascii=False) + "\n")
        else:
            print(f"{name}: identical")
    server.shutdown()
    return 1 if differs and not args.write else 0


if __name__ == "__main__":
    sys.exit(main())
