#!/usr/bin/env python3
"""Limits consistency gate (RFC 004).

Compares every numeric `LIM-` row of docs/src/maintainers/limits-and-defaults.md
with the constant that carries the same identifier in a trailing comment in
crates/rypsok-core/src/limits.rs, and fails on a mismatch or a missing side.
Rows whose default is not one number (derived values, vocabularies, lists)
are listed in NON_NUMERIC and skipped.
"""
from __future__ import annotations

import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
TABLE = ROOT / "docs" / "src" / "maintainers" / "limits-and-defaults.md"
SOURCE = ROOT / "crates" / "rypsok-core" / "src" / "limits.rs"

NON_NUMERIC = {"LIM-S7", "LIM-F5", "LIM-F8", "LIM-C9", "LIM-B4", "LIM-B5",
               "LIM-I3", "LIM-P1", "LIM-P2", "LIM-P3", "LIM-K1",
               "LIM-U1", "LIM-U2", "LIM-U3", "LIM-U4"}
UNITS = {"MiB": 1024 * 1024, "KiB": 1024, "hours": 3600, "hour": 3600}

ROW = re.compile(r"^\| (LIM-[A-Z]+\d+) \| [^|]* \| ([^|]*) \|", re.MULTILINE)
CONST = re.compile(r"pub const \w+: \w+ = ([0-9_]+); // (LIM-[A-Z]+\d+)")


def table_value(cell: str) -> int | None:
    m = re.search(r"(\d[\d_]*)\s*([A-Za-z]+)?", cell)
    if not m:
        return None
    value = int(m.group(1).replace("_", ""))
    unit = m.group(2) or ""
    return value * UNITS.get(unit, 1)


def main() -> int:
    table = {}
    for m in ROW.finditer(TABLE.read_text(encoding="utf-8")):
        lim, cell = m.group(1), m.group(2)
        if lim in NON_NUMERIC:
            continue
        value = table_value(cell)
        if value is None:
            print(f"check-limits: {lim}: cannot read a number from {cell.strip()!r}; add it to NON_NUMERIC if intended", file=sys.stderr)
            return 2
        table[lim] = value
    code = {}
    for m in CONST.finditer(SOURCE.read_text(encoding="utf-8")):
        code[m.group(2)] = int(m.group(1).replace("_", ""))
    problems = []
    for lim, value in sorted(table.items()):
        if lim not in code:
            problems.append(f"{lim}: in the table ({value}) but no constant carries it")
        elif code[lim] != value:
            problems.append(f"{lim}: table says {value}, limits.rs says {code[lim]}")
    for lim in sorted(set(code) - set(table)):
        problems.append(f"{lim}: constant exists but the table has no numeric row")
    if problems:
        print("check-limits: FAIL", file=sys.stderr)
        for p in problems:
            print(f"  {p}", file=sys.stderr)
        return 1
    print(f"check-limits: OK — {len(table)} limits match the table")
    return 0


if __name__ == "__main__":
    sys.exit(main())
