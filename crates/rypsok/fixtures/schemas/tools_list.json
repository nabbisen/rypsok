    {
      "name": "engine_status",
      "description": "Report the state of each configured engine. For diagnosis, not for answering questions.",
      "inputSchema": {
        "additionalProperties": false,
        "type": "object"
      },
      "outputSchema": {
        "$defs": {
          "DisabledReason": {
            "description": "Why an engine is `disabled`, from a closed vocabulary (REQ-STATUS-001;\nRFC 020, DAT-18). Never a secret, a path or an error text.",
            "oneOf": [
              {
                "const": "disabled",
                "description": "The operator disabled it in the configuration (`enabled = false`).",
                "type": "string"
              },
              {
                "const": "no_credential",
                "description": "It needs a credential and none could be read.",
                "type": "string"
              }
            ]
          },
          "EngineId": {
            "description": "The identifier of a configured engine: lowercase letters, digits and\nunderscores, starting with a letter, at most 32 characters.",
            "type": "string"
          },
          "EngineState": {
            "description": "The state of an engine's circuit (REQ-STATUS-001).",
            "oneOf": [
              {
                "const": "disabled",
                "description": "Disabled by configuration or inactive for lack of a credential.",
                "type": "string"
              },
              {
                "const": "closed",
                "description": "In use.",
                "type": "string"
              },
              {
                "const": "open",
                "description": "Skipped during a cooldown.",
                "type": "string"
              },
              {
                "const": "half_open",
                "description": "One probe request in flight.",
                "type": "string"
              }
            ]
          },
          "EngineStatus": {
            "description": "The state of one engine as `engine_status` reports it.",
            "properties": {
              "id": {
                "$ref": "#/$defs/EngineId",
                "description": "The configured identifier."
              },
              "latency_ms": {
                "description": "Median latency of the last LIM-S11 completed requests, or null.",
                "format": "uint32",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "reason": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/DisabledReason"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Why the engine is `disabled`; absent for every other state."
              },
              "state": {
                "$ref": "#/$defs/EngineState",
                "description": "The circuit state."
              }
            },
            "required": [
              "id",
              "state"
            ],
            "type": "object"
          },
          "Notice": {
            "description": "A notice: something rypsok did or could not do, from a fixed vocabulary.",
